def layout(rows: int) -> dict:
    """Stack the panel for a square screen.

    A fullscreen terminal on the 720×720 display is about 40 rows. The file
    list stays short, the open script gets the large area, and the activity
    log is a strip under it.
    """
    top = 2
    bottom = rows - 2
    body = bottom - top + 1
    if body >= 22:
        script, log = 8, 6
    elif body >= 16:
        script, log = 6, 5
    else:
        script, log = max(5, body - 5), 5
        script = min(script, body - log)
    preview = body - script - log
    if preview < 4:
        preview = 0
        script = body - log
    y = top
    boxes = {"script": (y, script), "preview": None, "log": (0, log), "footer": rows - 1}
    y += script
    if preview:
        boxes["preview"] = (y, preview)
        y += preview
    boxes["log"] = (y, log)
    return boxes


