def wrap_plain(text: str, width: int) -> list[str]:
    if width < 8:
        width = 8
    words = text.split()
    if not words:
        return [""]
    lines: list[str] = []
    cur = ""
    for word in words:
        while len(word) > width:
            if cur:
                lines.append(cur)
                cur = ""
            lines.append(word[:width])
            word = word[width:]
        if not cur:
            cur = word
        elif len(cur) + 1 + len(word) <= width:
            cur += " " + word
        else:
            lines.append(cur)
            cur = word
    if cur:
        lines.append(cur)
    return lines


def top_line_limit(line_count: int) -> int:
    """The last line may sit on the first row, so scrolling can reach it."""
