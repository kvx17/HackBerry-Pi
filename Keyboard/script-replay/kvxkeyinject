def _key(keycode: int, modifier: int = 0) -> bytes:
    return bytes((EVT_DOWN, keycode, modifier, 0, EVT_UP, keycode, modifier, 0))


def _delay(ms: int) -> bytes:
    if ms <= 0:
        return b""
    if ms > 65535:
        raise ScriptError("DELAY must be 1 to 65535 milliseconds")
    return bytes((EVT_DELAY, ms & 0xFF, (ms >> 8) & 0xFF, 0))


def _char(ch: str) -> bytes:
    if ch in UNSHIFTED:
        return _key(UNSHIFTED[ch])
    if ch in SHIFTED:
        return _key(UNSHIFTED[SHIFTED[ch]], MOD_LSFT)
    raise ScriptError(f"unsupported character {ch!r}")


def _chord(spec: str) -> bytes:
    parts = spec.split("-")
    if len(parts) < 2 or any(not part for part in parts):
        raise ScriptError(f"bad chord {spec!r}")
    *mods, last = parts
    modifier = 0
    for name in mods:
        bit = MODS.get(name.upper())
        if bit is None:
            raise ScriptError(f"unknown modifier {name!r}")
        modifier |= bit
    last_up = last.upper()
    if last_up in NAMED:
        return _key(NAMED[last_up], modifier)
    if len(last) != 1:
        raise ScriptError(f"bad chord key {last!r}")
    if last in UNSHIFTED:
        return _key(UNSHIFTED[last], modifier)
    if last in SHIFTED:
        return _key(UNSHIFTED[SHIFTED[last]], modifier | MOD_LSFT)
    raise ScriptError(f"bad chord key {last!r}")


def _string_body(text: str) -> str:
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        return text[1:-1]
    return text


def _millis(line: str) -> int:
    parts = line.split()
    if len(parts) != 2:
        raise ScriptError(f"{parts[0]} needs a millisecond count")
    ms = int(parts[1])
    if ms < 1 or ms > 65535:
        raise ScriptError("delay must be 1 to 65535 milliseconds")
    return ms


def _token_key(token: str) -> tuple[int, int]:
    """Keycode and extra shift bit for one key token."""
    named = NAMED.get(token.upper())
    if named is not None:
        return named, 0
    if len(token) != 1:
        raise ScriptError(f"unknown key {token!r}")
    if token in UNSHIFTED:
        return UNSHIFTED[token], 0
    if token in SHIFTED:
        return UNSHIFTED[SHIFTED[token]], MOD_LSFT
    raise ScriptError(f"unknown key {token!r}")


def _modifier_line(line: str) -> bytes | None:
    parts = line.split()
    if not parts or parts[0].upper() not in MODS:
        return None
    modifier = 0
    key_token = None
    for part in parts:
        bit = MODS.get(part.upper())
        if bit is not None and key_token is None:
            modifier |= bit
            continue
        if key_token is not None:
            raise ScriptError(f"unknown key {part!r}")
        key_token = part
    if key_token is None:
        return _key(0, modifier)
    keycode, extra = _token_key(key_token)
    return _key(keycode, modifier | extra)


def translate(text: str, gap_ms: int = GAP_MS) -> bytes:
    """Expand the text subset into 4-byte events. REPEAT is expanded here."""
    ops = []
    stack = []
    for number, raw in enumerate(text.splitlines(), 1):
        line = raw.strip()
        upper = line.upper()
        if not line or line.startswith("#") or upper == "REM" or upper.startswith("REM "):
            continue
        try:
            if upper.startswith("REPEAT"):
                count = int(line.split()[1])
                if count < 1:
                    raise ScriptError("REPEAT count must be at least 1")
                stack.append((count, len(ops)))
            elif upper == "ENDREPEAT":
                if not stack:
                    raise ScriptError("ENDREPEAT without REPEAT")
                count, start = stack.pop()
                block = ops[start:]
                for _ in range(count - 1):
                    ops.extend(block)
            else:
                ops.append(line)
        except ScriptError as exc:
            raise ScriptError(f"line {number}: {exc}") from exc
        except (IndexError, ValueError) as exc:
            raise ScriptError(f"line {number}: {exc}") from exc
    if stack:
        raise ScriptError("REPEAT without ENDREPEAT")

    out = bytearray()
    default_delay = 0
    for line in ops:
        upper = line.upper()
        if upper.startswith("DEFAULT_DELAY") or upper.startswith("DEFAULTDELAY"):
            default_delay = _millis(line)
            continue
        if upper.startswith("STRINGLN"):
            body = _string_body(line[8:].strip())
            for index, ch in enumerate(body):
                out += _char(ch)
                if gap_ms and index + 1 < len(body):
                    out += _delay(gap_ms)
            out += _key(NAMED["ENTER"])
        elif upper.startswith("STRING"):
            body = _string_body(line[6:].strip())
            for index, ch in enumerate(body):
                out += _char(ch)
                if gap_ms and index + 1 < len(body):
                    out += _delay(gap_ms)
        elif upper.startswith("DELAY"):
            out += _delay(_millis(line))
        elif upper in NAMED:
            out += _key(NAMED[upper])
        elif (pressed := _modifier_line(line)) is not None:
            out += pressed
        elif "-" in line:
            out += _chord(line)
        else:
            raise ScriptError(f"unknown command {line!r}")
        if default_delay and not upper.startswith("DELAY"):
            out += _delay(default_delay)
    if len(out) > 32 * 1024:
        raise ScriptError("script is larger than 32 KB")
    if len(out) % 4:
        raise ScriptError("encoder produced a partial event")
    return bytes(out)


class Board:
    def __init__(self, device, out_ep, in_ep):
        self.device = device
        self.out_ep = out_ep
        self.in_ep = in_ep

    def close(self) -> None:
        import usb.util

        usb.util.release_interface(self.device, IFACE)
        try:
            self.device.attach_kernel_driver(IFACE)
        except Exception:
            pass

    def xfer(self, payload: bytes, timeout: int = 1000) -> bytes:
        report = payload + bytes(REPORT - len(payload))
        if len(report) != REPORT:
            raise ScriptError("report is not 32 bytes")
        try:
            wrote = self.device.write(self.out_ep, report, timeout)
        except Exception as exc:
            raise ScriptError(f"short write: {exc}") from exc
        if wrote != REPORT:
            raise ScriptError(f"short write: sent {wrote} of {REPORT}")
        try:
            data = bytes(self.device.read(self.in_ep, REPORT, timeout))
        except Exception as exc:
            raise ScriptError(f"ACK timeout: {exc}") from exc
        if len(data) != REPORT:
            raise ScriptError(f"short read: got {len(data)} of {REPORT}")
        return data

    def status(self, cmd: int = CMD_STATUS) -> dict:
        data = self.xfer(bytes((cmd,)))
        if data[0] == 0xFF:
            raise ScriptError("keyboard replied unhandled; this firmware does not have the script protocol")
        if data[0] != cmd:
            raise ScriptError(f"unexpected reply command 0x{data[0]:02X}")
        return {
            "code": data[1],
            "proto": data[2],
            "state": data[3],
            "max_len": data[4] | (data[5] << 8),
            "length": data[6] | (data[7] << 8),
            "crc": int.from_bytes(data[8:12], "little"),
            "valid": data[12] == 1,
            "busy": data[13] == 1,
            "identity": data[14] == 1,
            "raw": data,
        }

    def wait_idle(self, timeout: float = 15.0) -> dict:
        deadline = time.monotonic() + timeout
        last = None
        while time.monotonic() < deadline:
            last = self.status()
            if last["code"] not in (OK, ERR_BUSY) or not last["busy"]:
                return last
            time.sleep(0.02)
        raise ScriptError("ACK timeout: flash job did not finish")


def open_board():
    try:
        import usb.core
        import usb.util
    except ImportError as exc:
        raise ScriptError("pyusb is not installed in this Python") from exc

    devices = list(usb.core.find(find_all=True, idVendor=VID, idProduct=PID))
    if not devices:
        raise ScriptError("device missing: no USB device at 4242:0003 (switch the keyboard internal)")
    device = devices[0]
    try:
        if device.is_kernel_driver_active(IFACE):
            device.detach_kernel_driver(IFACE)
        usb.util.claim_interface(device, IFACE)
    except Exception as exc:
        raise ScriptError(f"claim failure on interface {IFACE}: {exc}") from exc

    intf = usb.util.find_descriptor(device.get_active_configuration(), bInterfaceNumber=IFACE)
    if intf is None:
        raise ScriptError("claim failure: interface 1 is missing")
    out_ep = None
    in_ep = None
    for endpoint in intf:
        if usb.util.endpoint_direction(endpoint.bEndpointAddress) == usb.util.ENDPOINT_OUT:
            out_ep = endpoint.bEndpointAddress
        else:
            in_ep = endpoint.bEndpointAddress
    if out_ep is None or in_ep is None:
        raise ScriptError("claim failure: interface 1 has no IN/OUT pair")
    return Board(device, out_ep, in_ep)


def require_ok(data: bytes, what: str) -> None:
    if data[0] == 0xFF:
        raise ScriptError("keyboard replied unhandled; this firmware does not have the script protocol")
    if data[1] != OK:
        raise ScriptError(f"{what}: {ERR_NAME.get(data[1], data[1])}")


def cmd_send(board: Board, payload: bytes, emit=say) -> None:
    info = board.status()
    limit = info["max_len"] or (32 * 1024)
    if info["busy"]:
        raise ScriptError("keyboard is busy writing flash; wait, then send again")
    if len(payload) > limit:
        raise ScriptError(
            f"script is {len(payload)} bytes and the RP2040 slot holds {limit}. Nothing was written."
        )
    emit(f"fits {len(payload)}/{limit} bytes")
    digest = crc32(payload)
    begin = bytes((CMD_BEGIN,)) + len(payload).to_bytes(4, "little") + digest.to_bytes(4, "little")
    require_ok(board.xfer(begin), "begin")
    offset = 0
    total = len(payload)
    while offset < total:
        n = min(CHUNK, total - offset)
        packet = bytes((CMD_DATA, offset & 0xFF, (offset >> 8) & 0xFF, n)) + payload[offset : offset + n]
        reply = board.xfer(packet)
        require_ok(reply, "data")
        offset += n
        emit(f"send {offset}/{total}")
    reply = board.xfer(bytes((CMD_COMMIT,)))
    if reply[1] == ERR_CRC:
        raise ScriptError("commit: bad CRC")
    if reply[1] not in (OK, ERR_BUSY):
        raise ScriptError(f"commit: {ERR_NAME.get(reply[1], reply[1])}")
    done = board.wait_idle()
    if not done["valid"] or done["crc"] != digest or done["length"] != len(payload):
        raise ScriptError("commit finished but the slot is not valid")
    emit(f"stored {done['length']} bytes crc {done['crc']:08x}")


def read_back(board: Board, length: int) -> bytes:
    out = bytearray()
    offset = 0
    while offset < length:
        n = min(CHUNK, length - offset)
        reply = board.xfer(bytes((CMD_READ, offset & 0xFF, (offset >> 8) & 0xFF, n)))
        require_ok(reply, "read")
        out += reply[5 : 5 + n]
        offset += n
    return bytes(out)


def cmd_identity_set(board: Board, sub: int, text: bytes = b"") -> None:
    packet = bytes((CMD_IDENTITY_SET, sub, len(text))) + text
    reply = board.xfer(packet)
    if reply[1] == ERR_BUSY:
        done = board.wait_idle()
        if done["code"] != OK:
            raise ScriptError(f"identity: {ERR_NAME.get(done['code'], done['code'])}")
        return
    require_ok(reply, "identity")


def cmd_identity_get(board: Board, sub: int) -> str:
    reply = board.xfer(bytes((CMD_IDENTITY_GET, sub)))
    require_ok(reply, "identity get")
    n = min(reply[2], NAME_MAX, max(0, len(reply) - 3))
    raw = reply[3 : 3 + n].split(b"\x00", 1)[0]
    return raw.decode("ascii", "replace")


def status_text(info: dict) -> str:
    return (
        f"proto {info['proto']} state {info['state']} "
        f"valid {int(info['valid'])} busy {int(info['busy'])} "
        f"length {info['length']} crc {info['crc']:08x} "
        f"identity {int(info['identity'])}"
    )


def status_brief(info: dict) -> str:
    if info["busy"]:
        slot = "busy"
    elif info["valid"]:
        slot = f"{info['length']} bytes loaded"
    else:
        slot = "slot empty"
    return f"4242:0003  {slot}"


def do_identity(board: Board, args, emit=say) -> None:
    if args.reset:
        cmd_identity_set(board, 4)
    elif args.random:
        manufacturer, product = random_identity()
        emit(f"manufacturer {manufacturer}")
        emit(f"product {product}")
        cmd_identity_set(board, 1, manufacturer.encode())
        cmd_identity_set(board, 2, product.encode())
    elif args.manufacturer or args.product:
        if args.manufacturer:
            cmd_identity_set(board, 1, check_name(args.manufacturer).encode())
        if args.product:
            cmd_identity_set(board, 2, check_name(args.product).encode())
    emit(f"manufacturer {cmd_identity_get(board, 1)}")
    emit(f"product {cmd_identity_get(board, 2)}")
    emit("The new strings appear on the next enumeration, after the left switch is flipped.")


def read_script(path: str) -> str:
    file = Path(path)
    if not file.is_file():
        raise ScriptError(f"script not found: {path}")
    try:
        if file.stat().st_size > 1024 * 1024:
            raise ScriptError("script file is larger than 1 MB")
        return file.read_text(encoding="utf-8")
    except ScriptError:
        raise
    except UnicodeError as exc:
        raise ScriptError(f"script is not UTF-8: {path}") from exc
    except OSError as exc:
        raise ScriptError(f"cannot read {path}: {exc}") from exc


def label(path: Path) -> str:
    try:
        return str(path.relative_to(HERE))
    except ValueError:
        return path.name


class Row(NamedTuple):
    path: Path
    kind: str
    depth: int


TREE_CLOSED = ">"
TREE_OPEN = "↓"
TREE_LINE = "│"


def tree_label(row: Row, expanded: set[Path]) -> str:
    """Closed folders start with >. Open ones start with a down arrow, and a line sits before each child."""
    gutter = f"{TREE_LINE} " * row.depth
    if row.kind == "dir":
        mark = TREE_OPEN if row.path in expanded else TREE_CLOSED
        return f"{gutter}{mark}{row.path.name}"
    return f"{gutter}{row.path.name}"


def _dir_kids(folder: Path) -> tuple[list[Path], list[Path]]:
    try:
        kids = list(folder.iterdir())
    except OSError:
        return [], []
    dirs: list[Path] = []
    files: list[Path] = []
    for kid in kids:
        if kid.name.startswith(".") or kid.name == "__pycache__":
            continue
        if kid.is_dir():
            dirs.append(kid)
        elif kid.is_file() and kid.suffix == ".txt":
            files.append(kid)
    dirs.sort(key=lambda path: path.name.lower())
    files.sort(key=lambda path: path.name.lower())
    return dirs, files


def visible_tree(
    roots: list[Path],
    expanded: set[Path],
    include_root: bool,
    base_depth: int = 0,
) -> list[Row]:
    """Flatten folders the user has opened. Closed folders hide their children."""
    rows: list[Row] = []
    seen: set[Path] = set()

    def add_children(folder: Path, depth: int) -> None:
        try:
            key = folder.resolve()
        except OSError:
            key = folder
        if key in seen:
            return
        seen.add(key)
        dirs, files = _dir_kids(folder)
        for child in dirs:
            opened = child in expanded
            rows.append(Row(child, "dir", depth))
            if opened:
                add_children(child, depth + 1)
        for child in files:
            rows.append(Row(child, "file", depth))
        seen.discard(key)

    for root in roots:
        if not root.is_dir():
            continue
        if include_root:
            rows.append(Row(root, "dir", base_depth))
            if root in expanded:
                add_children(root, base_depth + 1)
        else:
            add_children(root, base_depth)
    return rows


SAVED_FOLDERS = HERE / "scripts" / ".folders"


def load_saved_folders(path: Path | None = None) -> list[Path]:
    """Folders the user added with f. One absolute path per line."""
    file = path or SAVED_FOLDERS
    if not file.is_file():
        return []
    found: list[Path] = []
    seen: set[Path] = set()
    try:
        lines = file.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeError):
        return []
    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        folder = Path(line).expanduser()
        try:
            folder = folder.resolve()
        except OSError:
            pass
        if folder in seen:
            continue
        seen.add(folder)
        found.append(folder)
    return found


def save_saved_folders(folders: list[Path], path: Path | None = None) -> None:
    file = path or SAVED_FOLDERS
    file.parent.mkdir(parents=True, exist_ok=True)
    body = "".join(f"{folder}\n" for folder in folders)
    file.write_text(body, encoding="utf-8")


