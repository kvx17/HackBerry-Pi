        curses.init_pair(4, curses.COLOR_GREEN, default)
        curses.init_pair(5, curses.COLOR_WHITE, default)
        curses.init_pair(6, curses.COLOR_GREEN, curses.COLOR_MAGENTA)
        curses.init_pair(7, curses.COLOR_WHITE, curses.COLOR_MAGENTA)
        self.attr_header = curses.color_pair(1) | curses.A_BOLD
        self.attr_ok = curses.color_pair(6) | curses.A_BOLD
        self.attr_err = curses.color_pair(3) | curses.A_BOLD
        self.attr_sel = curses.color_pair(2)
        self.attr_warn = curses.color_pair(5)
        self.attr_accent = curses.color_pair(4) | curses.A_BOLD
        self.attr_good = curses.color_pair(4)
        self.attr_secondary = curses.color_pair(5)

    def add(self, y: int, x: int, text: str, attr: int = 0) -> None:
        if y < 0 or y >= self.rows or x >= self.width:
            return
        text = text.replace("\x00", "")[: max(0, self.width - x)]
        if not text:
            return
        try:
            self.stdscr.addstr(y, x, text, attr)
        except (curses.error, ValueError):
            pass

    def box(self, y: int, x: int, h: int, w: int, title: str = "", extra: str = "") -> None:
        if h < 2 or w < 4 or y < 0 or x < 0:
            return
        if y + h > self.rows or x + w > self.width:
            return
        attr = self.attr_accent
        try:
            self.stdscr.hline(y, x + 1, curses.ACS_HLINE, w - 2, attr)
            self.stdscr.hline(y + h - 1, x + 1, curses.ACS_HLINE, w - 2, attr)
            if h > 2:
                self.stdscr.vline(y + 1, x, curses.ACS_VLINE, h - 2, attr)
                self.stdscr.vline(y + 1, x + w - 1, curses.ACS_VLINE, h - 2, attr)
            self.stdscr.addch(y, x, curses.ACS_ULCORNER, attr)
            self.stdscr.addch(y, x + w - 1, curses.ACS_URCORNER, attr)
            self.stdscr.addch(y + h - 1, x, curses.ACS_LLCORNER, attr)
            self.stdscr.addch(y + h - 1, x + w - 1, curses.ACS_LRCORNER, attr)
        except curses.error:
            pass
        label_text = f" {title} "[: max(0, w - 4)]
        self.add(y, x + 2, label_text, attr)
        if extra:
            right = f" {extra} "
            if len(label_text) + len(right) + 3 < w:
                self.add(y, x + w - 1 - len(right), right, attr)

    def too_small(self) -> bool:
        return self.rows < MIN_ROWS or self.cols < MIN_COLS

    def current_row(self) -> Row | None:
        if not self.entries:
            return None
        if self.selected < 0 or self.selected >= len(self.entries):
            return None
        return self.entries[self.selected]

    def current(self) -> Path | None:
        row = self.current_row()
        if row is None or row.kind != "file":
            return None
        return row.path

    def select(self, index: int) -> None:
        if not self.entries:
            self.selected = 0
            return
        index = max(0, min(len(self.entries) - 1, index))
        if index != self.selected:
            self.preview_scroll = 0
        self.selected = index

    def header_attr(self) -> int:
        if self.device_error:
            return self.attr_err
        return self.attr_header

    def refresh_device(self, announce: bool = False) -> None:
        try:
            info = read_status()
        except ScriptError as exc:
            self.device_error = str(exc)
            self.loaded = False
            text = str(exc)
            if "claim" in text:
                self.status = "claim failed"
            elif "missing" in text:
                self.status = "no keyboard"
            else:
                self.status = "not ready"
            self.messages.append(f"error: {exc}")
            return
        self.device_error = ""
        self.loaded = bool(info["valid"]) and not info["busy"]
        self.status = status_brief(info)
        if announce:
            self.messages.append(status_text(info))

    def emit(self, text: str) -> None:
        self.messages.append(text)
        if len(self.messages) > 300:
            self.messages = self.messages[-300:]
        self.draw()
        self.stdscr.refresh()

    def invoke(self, args) -> None:
        try:
            run_command(args, emit=self.emit)
        except ScriptError as exc:
            self.messages.append(f"error: {exc}")

    def move(self, delta: int) -> None:
        self.select(self.selected + delta)

    def scroll_script(self, delta: int) -> None:
        self.preview_scroll = max(0, self.preview_scroll + delta)
        if self.view in ("read", "guide"):
            self.doc_scroll = max(0, self.doc_scroll + delta)

    def build_entries(self) -> list[Row]:
        examples = HERE / "examples"
        scripts = HERE / "scripts"
        if not self.roots_opened:
            for path in (examples, scripts):
                if path.is_dir():
                    self.expanded.add(path)
            self.roots_opened = True
        rows = visible_tree([examples], self.expanded, include_root=True)
        script_rows = visible_tree([scripts], self.expanded, include_root=True)
        if scripts in self.expanded:
            extra = saved_folder_rows(self.extra, self.expanded)
            insert_at = len(script_rows)
            for index, row in enumerate(script_rows):
                if row.kind == "file":
                    insert_at = index
                    break
            script_rows[insert_at:insert_at] = extra
        rows.extend(script_rows)
        return rows

    def rescan(self, announce: bool = True) -> None:
        previous = self.current_row().path if self.entries else None
        self.entries = self.build_entries()
        for row in self.entries:
            if row.kind == "file" and row.path not in self.notes:
                self.notes[row.path] = event_note(row.path)
        found = False
        if previous is not None:
            for index, row in enumerate(self.entries):
                if row.path == previous:
                    self.selected = index
                    found = True
                    break
        if not found:
            self.selected = min(self.selected, max(0, len(self.entries) - 1))
            self.preview_scroll = 0
            if previous is None:
                for index, row in enumerate(self.entries):
                    if row.kind == "file":
                        self.selected = index
                        break
        if self.selected >= len(self.entries):
            self.selected = max(0, len(self.entries) - 1)
        self.scroll = min(self.scroll, self.selected)
        if announce:
            files = sum(row.kind == "file" for row in self.entries)
            folders = sum(row.kind == "dir" for row in self.entries)
            self.messages.append(f"{files} scripts, {folders} folders")

    def toggle_dir(self, path: Path | None = None) -> None:
        row = self.current_row()
        target = path or (row.path if row and row.kind == "dir" else None)
        if target is None:
            return
        if target in self.expanded:
            self.expanded.remove(target)
        else:
            self.expanded.add(target)
        self.rescan(announce=False)

    def activate(self) -> None:
        row = self.current_row()
        if row is None:
            self.messages.append("Select a script first. Put .txt files in scripts/.")
            return
        if row.kind == "dir":
            self.toggle_dir(row.path)
            return
        self.do_send()

    def confirm(self, question: str) -> bool:
        self.prompt = question + "  y/n"
        try:
            self.draw()
            self.stdscr.refresh()
            while True:
                key = self.stdscr.getch()
                if key in (ord("y"), ord("Y")):
                    return True
                if key in (ord("n"), ord("N"), 27, ord("q"), ord("Q")):
                    return False
        finally:
            self.prompt = ""

    def ask_text(self, label_text: str, limit: int = NAME_MAX, preset: str = "") -> str | None:
        try:
            curses.curs_set(1)
        except curses.error:
            pass
        buf = list(preset)
        try:
            while True:
                shown = label_text + "".join(buf)
                self.prompt = shown
                self.draw()
                self.stdscr.refresh()
                key = self.stdscr.getch()
                if key in (10, 13, curses.KEY_ENTER):
                    return "".join(buf).strip()
                if key == 27:
                    return None
                if key in (curses.KEY_BACKSPACE, 127, 8):
                    if buf:
                        buf.pop()
                    continue
                if 32 <= key <= 126 and len(buf) < limit:
                    buf.append(chr(key))
        finally:
            self.prompt = ""
            try:
                curses.curs_set(0)
            except curses.error:
                pass

    def current_folder(self) -> Path:
        row = self.current_row()
        if row is not None:
            return row.path if row.kind == "dir" else row.path.parent
        if self.source is not None:
            return self.source
        folder = HERE / "scripts"
        folder.mkdir(exist_ok=True)
        return folder

    def run_nano(self, path: Path) -> None:
        if shutil.which("nano") is None:
            self.messages.append("nano is not installed. Install it with: sudo apt install nano")
            return
        curses.def_prog_mode()
        curses.endwin()
        try:
            subprocess.run(["nano", str(path)])
        finally:
            curses.reset_prog_mode()
            try:
                curses.curs_set(0)
            except curses.error:
                pass
            self.stdscr.keypad(True)
            self.stdscr.refresh()
        self.rescan(announce=False)
        self.messages.append(f"closed {path.name}")

    def select_path(self, path: Path) -> None:
        try:
            key = path.resolve()
        except OSError:
            key = path
        for index, row in enumerate(self.entries):
            if row.path == path or row.path == key:
                self.select(index)
                return

    def do_fetch(self) -> None:
        raw = self.ask_text("folder: ", limit=240, preset=FOLDER_HINT)
        if not raw:
            self.messages.append("folder left unchanged")
            return
        folder = Path(raw).expanduser()
        if not folder.is_dir():
            self.messages.append(f"not a folder: {folder}")
            self.messages.append(f"example: {FOLDER_HINT}")
            return
        try:
            folder = folder.resolve()
        except OSError:
            pass
        scripts = (HERE / "scripts").resolve()
        examples = (HERE / "examples").resolve()
        if folder in (scripts, examples) or scripts in folder.parents or examples in folder.parents:
            self.messages.append("that folder is already in the list")
            self.expanded.add(HERE / "scripts")
            self.expanded.add(folder)
            self.rescan(announce=False)
            self.select_path(folder)
            return
        if folder in self.extra:
            self.messages.append(f"{folder.name} is already under scripts")
        else:
            self.extra.append(folder)
            try:
                save_saved_folders(self.extra)
            except OSError as exc:
                self.extra.pop()
                self.messages.append(f"error: {exc}")
                return
            self.messages.append(f"saved {folder.name} under scripts")
        self.expanded.add(HERE / "scripts")
        self.expanded.add(folder)
        self.rescan(announce=False)
        self.select_path(folder)

    def do_read(self) -> None:
        if self.current() is None:
            self.messages.append("Select a script first.")
            return
        self.doc_scroll = 0
        self.view_return = "main"
        self.view = "read"

    def do_edit(self) -> None:
        path = self.current()
        if path is None:
            self.messages.append("Select a script first.")
            return
        self.run_nano(path)

    def do_new(self) -> None:
        folder = self.current_folder()
        name = self.ask_text("new file: ", limit=64)
        if not name:
            if name == "":
                self.messages.append("new file cancelled")
            return
        if "/" in name or name in (".", ".."):
            self.messages.append("Use a file name. f sets the folder.")
            return
        if not name.endswith(".txt"):
            name += ".txt"
        path = folder / name
        if path.exists() and not self.confirm(f"Overwrite {name}?"):
            self.messages.append("new file cancelled")
            return
        try:
            if not path.exists():
                path.write_text("", encoding="utf-8")
        except OSError as exc:
            self.messages.append(f"error: {exc}")
            return
        self.expanded.add(folder)
        self.run_nano(path)
        for index, row in enumerate(self.entries):
            if row.kind == "file" and row.path == path:
                self.select(index)
                break

    def open_guide(self) -> None:
        self.doc_scroll = 0
        self.view_return = self.view if self.view != "guide" else "main"
        self.view = "guide"

    def close_page(self) -> None:
        self.view = self.view_return if self.view_return in ("main", "identity", "read") else "main"
        if self.view == "guide":
            self.view = "main"

    def do_send(self) -> None:
        path = self.current()
        if path is None:
            self.messages.append("Select a script first. Put .txt files in scripts/.")
            return
        rel = label(path)
        if not self.confirm(f"Send {rel}?"):
            self.messages.append("send cancelled")
            return
        self.messages.append(f"sending {rel}")
        self.draw()
        self.stdscr.refresh()
        self.invoke(namespace("send", file=str(path)))
        self.refresh_device()

    def do_verify(self) -> None:
        path = self.current()
        if path is None:
            self.messages.append("Select a script first.")
            return
        self.messages.append(f"verifying {label(path)}")
        self.draw()
        self.stdscr.refresh()
        self.invoke(namespace("verify", file=str(path)))
        self.refresh_device()

    def do_clear(self) -> None:
        if not self.confirm("Clear the stored script?"):
            self.messages.append("clear cancelled")
            return
        self.invoke(namespace("clear"))
        self.refresh_device()

    def do_list(self) -> None:
        self.invoke(namespace("list"))

    def open_identity(self) -> None:
        self.view = "identity"
        self.draw()
        self.stdscr.refresh()
        try:
            self.mfr, self.product_name = read_names()
        except ScriptError as exc:
            self.messages.append(f"error: {exc}")
            return
        self.messages.append(f"name {self.mfr or '(not set)'} / {self.product_name or '(not set)'}")

    def commit_identity(self, **kwargs) -> None:
        self.invoke(namespace("identity", **kwargs))
        try:
            self.mfr, self.product_name = read_names()
        except ScriptError as exc:
            self.messages.append(f"error: {exc}")

    def on_mouse(self) -> None:
        if self.view != "main":
            return
        try:
            _ident, _mx, my, _mz, _bstate = curses.getmouse()
        except curses.error:
            return
        origin, height = self.boxes.get("script", (0, 0))
        if my <= origin or my >= origin + height - 1:
            return
        index = self.scroll + (my - (origin + 1))
        if index < 0 or index >= len(self.entries):
            return
        now = time.monotonic()
        if self.click_index == index and now - self.click_time < 0.5:
            self.select(index)
            self.click_index = -1
            self.click_time = 0
            self.activate()
            return
        self.select(index)
        self.click_index = index
        self.click_time = now

    def handle_main(self, key: int) -> bool:
        if key in (ord("q"), ord("Q")):
            return False
        if key in (curses.KEY_UP, ord("k")):
            self.move(-1)
        elif key in (curses.KEY_DOWN, ord("j")):
            self.move(1)
        elif key in (ord("u"), ord("U")):
            self.scroll_script(-1)
        elif key in (ord("i"), ord("I")):
            self.scroll_script(1)
        elif key == curses.KEY_RIGHT:
            row = self.current_row()
            if row and row.kind == "dir" and row.path not in self.expanded:
                self.toggle_dir(row.path)
        elif key == curses.KEY_LEFT:
            row = self.current_row()
            if row and row.kind == "dir" and row.path in self.expanded:
                self.toggle_dir(row.path)
            elif row:
                parent = row.path.parent
                for index, item in enumerate(self.entries):
                    if item.path == parent:
                        self.select(index)
                        break
        elif key == curses.KEY_PPAGE:
            self.move(-max(1, self.script_inner - 1))
        elif key == curses.KEY_NPAGE:
            self.move(max(1, self.script_inner - 1))
        elif key == curses.KEY_HOME:
            self.select(0)
        elif key == curses.KEY_END:
            self.select(max(0, len(self.entries) - 1))
        elif key in (10, 13, curses.KEY_ENTER, ord("s"), ord("S")):
            self.activate()
        elif key in (ord("v"), ord("V")):
            self.do_verify()
        elif key in (ord("c"), ord("C")):
            self.do_clear()
        elif key in (ord("p"), ord("P")):
            self.refresh_device(announce=True)
        elif key in (ord("g"), ord("G")):
            self.open_identity()
        elif key in (ord("r"), ord("R")):
            self.do_read()
        elif key in (ord("e"), ord("E")):
            self.do_edit()
        elif key in (ord("n"), ord("N")):
            self.do_new()
        elif key in (ord("f"), ord("F")):
            self.do_fetch()
        elif key in (ord("h"), ord("H"), ord("?")):
            self.open_guide()
        elif key in (ord("l"), ord("L")):
            self.do_list()
        return True

    def handle_identity(self, key: int) -> bool:
        if key in (ord("q"), ord("Q")):
            return False
        if key in (ord("b"), ord("B"), 27):
            self.view = "main"
            return True
        if key in (ord("m"), ord("M")):
            name = self.ask_text("manufacturer: ")
            if name:
                self.commit_identity(manufacturer=name)
            elif name == "":
                self.messages.append("name left unchanged")
            return True
        if key in (ord("p"), ord("P")):
            name = self.ask_text("product: ")
            if name:
                self.commit_identity(product=name)
            elif name == "":
                self.messages.append("name left unchanged")
            return True
        if key in (ord("a"), ord("A")):
            if self.confirm("Pick a random fictional name?"):
                self.commit_identity(random=True)
            return True
        if key in (ord("x"), ord("X")):
            if self.confirm("Reset USB names?"):
                self.commit_identity(reset=True)
            return True
        if key in (ord("h"), ord("H"), ord("?")):
            self.open_guide()
        return True

    def handle_page(self, key: int) -> bool:
        if key in (ord("b"), ord("B"), ord("q"), ord("Q"), 27):
            self.close_page()
            return True
        if key in (curses.KEY_UP, ord("k"), ord("u"), ord("U")):
            self.doc_scroll -= 1
        elif key in (curses.KEY_DOWN, ord("j"), ord("i"), ord("I")):
            self.doc_scroll += 1
        elif key == curses.KEY_PPAGE:
            self.doc_scroll -= max(1, self.rows - 4)
        elif key == curses.KEY_NPAGE:
            self.doc_scroll += max(1, self.rows - 4)
        elif key == curses.KEY_HOME:
            self.doc_scroll = 0
        return True

    def handle(self, key: int) -> bool:
        if key == curses.KEY_RESIZE:
            return True
        if self.too_small():
            return key not in (ord("q"), ord("Q"))
        if self.view in ("read", "guide"):
            return self.handle_page(key)
        if key == curses.KEY_MOUSE:
            self.on_mouse()
            return True
        if self.view == "identity":
            return self.handle_identity(key)
        return self.handle_main(key)

    def clamp_scroll(self, inner: int) -> None:
        self.script_inner = max(1, inner)
        if not self.entries:
            self.selected = 0
            self.scroll = 0
            return
        self.selected = max(0, min(len(self.entries) - 1, self.selected))
        if self.selected < self.scroll:
            self.scroll = self.selected
        if self.selected >= self.scroll + self.script_inner:
            self.scroll = self.selected - self.script_inner + 1

    def footer_text(self) -> str:
        if self.prompt:
            return " " + self.prompt
        if self.view == "identity":
            if self.width >= 64:
                return " m manufacturer  p product  a random  x reset  b back  q quit"
            return " m name  p product  a random  x reset  b back"
        if self.width >= 70:
            return " j/k list  u/i script  enter  r read  e edit  n new  f folder  h  q"
        return " u/i script  enter  r  e  n  h  q"

    def safety_text(self) -> str:
        if self.width >= 60:
            return " Switch internal to load. External before Script play."
        return " Internal to load. External to play."

    def fill(self, y: int, x: int, h: int, w: int, attr: int = 0) -> None:
        blank = " " * max(0, w)
        for row in range(max(0, h)):
            self.add(y + row, x, blank, attr)

    def draw_too_small(self) -> None:
        self.add(0, 0, " kvxkeyinject".ljust(self.width), self.attr_header)
        lines = [
            "This window is too small.",
            "Fullscreen it on the 720×720 display.",
            "About 48 columns by 18 rows.",
            "q quits.",
        ]
        y = 2
        width = max(8, self.width)
        for line in lines:
            for part in wrap_plain(line, width):
                if y >= self.rows:
                    return
                self.add(y, 0, part)
                y += 1

    def draw_scripts(self, y: int, h: int) -> None:
        inner_h = h - 2
        inner_w = self.width - 4
        self.clamp_scroll(inner_h)
        extra = f"{self.selected + 1}/{len(self.entries)}" if self.entries else "0"
        self.box(y, 0, h, self.width, "scripts", extra)
        if not self.entries:
            if self.source is None:
                self.add(y + 1, 2, "f sets a folder. Example:", self.attr_secondary)
                if inner_h > 1:
                    self.add(y + 2, 2, FOLDER_HINT, self.attr_accent)
            else:
                self.add(y + 1, 2, "This folder is empty.", self.attr_warn)
                if inner_h > 1:
                    self.add(y + 2, 2, "n creates a script.", self.attr_secondary)
            return
        for row_i in range(inner_h):
            index = self.scroll + row_i
            if index >= len(self.entries):
                break
            row = self.entries[index]
            note = self.notes.get(row.path, "") if row.kind == "file" else ""
            name = tree_label(row, self.expanded)
            if index == self.selected:
                attr = self.attr_sel
            elif row.kind == "dir":
                attr = self.attr_accent
            elif note == "error":
                attr = self.attr_warn
            else:
                attr = self.attr_secondary
            if note and inner_w > len(note) + 6:
                room = inner_w - len(note) - 1
                shown = name[:room]
                text = shown + " " * (inner_w - len(shown) - len(note)) + note
            else:
                text = name
            self.add(y + 1 + row_i, 2, text.ljust(inner_w), attr)

    def preview_lines(self, inner_w: int) -> list[str]:
        row = self.current_row()
        if row is None:
            return [f"f sets a folder. Example: {FOLDER_HINT}"]
        if row.kind == "dir":
            if not row.path.is_dir():
                return [str(row.path), "This folder is missing."]
            opened = row.path in self.expanded
            state = "open" if opened else "closed"
            return [
                str(row.path),
                f"This folder is {state}. Enter opens or closes it.",
            ]
        try:
            text = row.path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            return wrap_plain(str(exc), inner_w)
        lines = text.splitlines() or ["(empty file)"]
        return [line[:inner_w] for line in lines]

    def draw_preview(self, y: int, h: int) -> None:
        inner_h = max(0, h - 2)
        inner_w = max(1, self.width - 4)
        path = self.current()
        row = self.current_row()
        title = label(path) if path else (row.path.name if row else "preview")
        lines = self.preview_lines(inner_w)
        max_scroll = top_line_limit(len(lines))
        self.preview_scroll = max(0, min(self.preview_scroll, max_scroll))
        extra = f"{self.preview_scroll + 1}/{len(lines)}" if len(lines) > inner_h else ""
        self.box(y, 0, h, self.width, title, extra)
        visible = lines[self.preview_scroll : self.preview_scroll + inner_h]
        for row_i, line in enumerate(visible):
            self.add(y + 1 + row_i, 2, line, self.attr_secondary)

    def draw_identity(self, y: int, h: int) -> None:
        self.box(y, 0, h, self.width, "usb name")
        rows = [
            (1, "manufacturer", self.attr_accent),
            (2, self.mfr or "(not set)", self.attr_good if self.mfr else self.attr_warn),
            (3, "product", self.attr_accent),
            (4, self.product_name or "(not set)", self.attr_good if self.product_name else self.attr_warn),
            (6, "Shown after the left switch is flipped.", self.attr_secondary),
        ]
        inner_h = h - 2
        for row, text, attr in rows:
            if row > inner_h:
                break
            self.add(y + row, 2, text, attr)

    def draw_log(self, y: int, h: int) -> None:
        inner_h = max(0, h - 2)
        inner_w = max(8, self.width - 4)
        self.box(y, 0, h, self.width, "activity")
        wrapped: list[str] = []
        for message in self.messages[-80:]:
            wrapped.extend(wrap_plain(message, inner_w))
        visible = wrapped[-inner_h:] if inner_h else []
        for row, line in enumerate(visible):
            attr = self.attr_err if line.startswith("error:") else self.attr_secondary
            self.add(y + 1 + row, 2, line, attr)

    def page_lines(self) -> list[tuple[str, bool]]:
        if self.view == "guide":
            return guide_text()
        path = self.current()
        if path is None:
            return [("(no script)", False)]
        try:
            text = path.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            return [(str(exc), False)]
        rows = text.splitlines() or ["(empty file)"]
        return [(line, False) for line in rows]

    def draw_page(self, title: str) -> None:
        self.add(0, 0, (" " + title).ljust(self.width)[: self.width], self.attr_header)
        inner_h = max(1, self.rows - 2)
        inner_w = max(8, self.width)
        wrapped: list[tuple[str, bool]] = []
        for text, heading in self.page_lines():
            if heading:
                wrapped.append((text[:inner_w], True))
                continue
            if self.view == "read":
                chunk = text
                wrapped.append((chunk[:inner_w], False))
                chunk = chunk[inner_w:]
                while chunk:
                    wrapped.append((chunk[:inner_w], False))
                    chunk = chunk[inner_w:]
                continue
            for line in wrap_plain(text, inner_w) if text else [""]:
                wrapped.append((line, False))
        max_scroll = top_line_limit(len(wrapped))
        self.doc_scroll = max(0, min(self.doc_scroll, max_scroll))
        visible = wrapped[self.doc_scroll : self.doc_scroll + inner_h]
        for row in range(inner_h):
            if row >= len(visible):
                break
            line, heading = visible[row]
            attr = self.attr_accent if heading else self.attr_secondary
            self.add(1 + row, 0, line, attr)
        hint = " u/i j/k scroll   b back"
        self.add(self.rows - 1, 0, hint.ljust(self.width)[: self.width], self.attr_header)

    def draw(self) -> None:
        self.rows, self.cols = self.stdscr.getmaxyx()
        self.width = max(1, self.cols - 1)
        self.stdscr.erase()
        if self.view == "read" and not self.too_small():
            path = self.current()
            self.draw_page(label(path) if path else "script")
            return
        if self.view == "guide" and not self.too_small():
            self.draw_page("help")
            return
        if self.too_small():
            self.draw_too_small()
            return
        self.boxes = layout(self.rows)
        title = " kvxkeyinject"
        status = " " + self.status
        gap = self.width - len(title) - len(status)
        if gap < 1:
            status = status[: max(0, self.width - len(title) - 1)]
            gap = max(1, self.width - len(title) - len(status))
        header = (title + " " * gap + status)[: self.width]
        self.add(0, 0, header.ljust(self.width), self.header_attr())
        if not self.device_error:
            status_attr = self.attr_ok if self.loaded else self.attr_header
            self.add(0, max(0, self.width - len(status)), status, status_attr)
        self.add(1, 0, self.safety_text()[: self.width], self.attr_secondary)
        y, h = self.boxes["script"]
        if self.view == "identity":
            self.draw_identity(y, h)
        else:
            self.draw_scripts(y, h)
        preview = self.boxes.get("preview")
        if preview and self.view == "main":
            self.draw_preview(*preview)
        elif preview and self.view == "identity":
            self.draw_log_gap(preview)
        self.draw_log(*self.boxes["log"])
        footer = self.footer_text()
        if len(footer) > self.width:
            footer = footer[-self.width :]
        self.add(self.boxes["footer"], 0, footer.ljust(self.width)[: self.width], self.attr_header)

    def draw_log_gap(self, preview: tuple[int, int]) -> None:
        """Keep the name page filled when the preview rows are spare."""
        y, h = preview
        self.box(y, 0, h, self.width, "note")
        note = "VID and PID stay 4242:0003. Names are fictional, up to 28 characters."
        inner_w = max(8, self.width - 4)
        for row, line in enumerate(wrap_plain(note, inner_w)[: max(0, h - 2)]):
            self.add(y + 1 + row, 2, line)

    def loop(self) -> None:
        self.setup()
        self.rescan(announce=False)
        self.messages.append("Load only. Play with Script play after the switch is external.")
        if self.hint:
            self.messages.append(self.hint)
        self.draw()
        self.stdscr.refresh()
        self.refresh_device(announce=True)
        while True:
            self.draw()
            self.stdscr.refresh()
            key = self.stdscr.getch()
            if not self.handle(key):
                return


def run_tui(stdscr) -> None:
    App(stdscr, fullscreen_hint()).loop()


def launch_ui() -> int:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("Run kvxkeyinject in a terminal on the Hackberry.")
        print("The panel is laid out for a fullscreen window on the 720×720 display.")
        return 1
    try:
        sys.stdout.write("\033]0;kvxkeyinject\007")
        sys.stdout.flush()
    except OSError:
        pass
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(run_tui)
    except curses.error as exc:
        print(f"Panel UI is not available ({exc}).")
        menu()
    return 0


def menu() -> None:
    print("kvxkeyinject. The keyboard switch must be internal.")
    print("1 ping  2 status  3 send  4 verify  5 clear  6 identity  7 list  8 files  q quit")
    while True:
        try:
            choice = input("> ").strip()
        except EOFError:
            print()
            return
        if choice in ("q", "quit", ""):
            return
        try:
            if choice == "1":
                run_command(namespace("ping"))
            elif choice == "2":
                run_command(namespace("status"))
            elif choice == "3":
                path = input("script file: ").strip()
                run_command(namespace("send", file=path))
            elif choice == "4":
                path = input("script file: ").strip()
                run_command(namespace("verify", file=path))
            elif choice == "5":
                run_command(namespace("clear"))
            elif choice == "6":
                print("1 show  2 set  3 random  4 reset")
                which = input("identity> ").strip()
                if which == "2":
                    run_command(namespace(
                        "identity",
                        manufacturer=input("manufacturer: "),
                        product=input("product: "),
                    ))
                elif which == "3":
                    run_command(namespace("identity", random=True))
                elif which == "4":
                    run_command(namespace("identity", reset=True))
                else:
                    run_command(namespace("identity"))
            elif choice == "7":
                run_command(namespace("list"))
            elif choice == "8":
                found = discover()
                if not found:
                    print("no .txt files in examples/ or scripts/")
                for path in found:
                    print(f"{label(path)}  {event_note(path)}")
            else:
                print("unknown choice")
        except ScriptError as exc:
            print(f"error: {exc}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Load a script into the Hackberry keyboard",
        epilog="With no arguments, open the panel. Fullscreen it on the 720×720 display.",
    )
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser("ping")
    sub.add_parser("list")
    sub.add_parser("info")
    sub.add_parser("status")
    sub.add_parser("clear")
    send = sub.add_parser("send")
    send.add_argument("file")
    verify = sub.add_parser("verify")
    verify.add_argument("file")
    ident = sub.add_parser("identity")
    ident.add_argument("--manufacturer")
    ident.add_argument("--product")
    ident.add_argument("--random", action="store_true")
    ident.add_argument("--reset", action="store_true")
    parser.add_argument("--selftest", action="store_true")
    return parser


def check_layout() -> None:
    for rows in range(MIN_ROWS, 80):
        got = layout(rows)
        y, height = got["script"]
        end = y + height
        preview = got["preview"]
        if rows >= 28:
            if not preview or preview[1] <= got["log"][1]:
                raise ScriptError(f"script view should be larger than the log at {rows} rows")
            py, ph = preview
            if py != end or ph < 4:
                raise ScriptError(f"preview placed wrong at {rows} rows")
            end = py + ph
        elif preview:
            py, ph = preview
            if py != end or ph < 4:
                raise ScriptError(f"preview placed wrong at {rows} rows")
            end = py + ph
        ly, lh = got["log"]
        if ly != end or ly + lh - 1 != rows - 2:
            raise ScriptError(f"log placed wrong at {rows} rows")
        if height < 5 or lh < 5:
            raise ScriptError(f"panel is cramped at {rows} rows")
        if got["footer"] != rows - 1:
            raise ScriptError("footer is not the last row")


def selftest() -> None:
    sample = b"123456789"
    if crc32(sample) != 0xCBF43926:
        raise ScriptError("CRC32 does not match the IEEE check value")
    payload = translate("STRING Hi!\nENTER\n")
    if payload[:4] != bytes((EVT_DOWN, UNSHIFTED["h"], MOD_LSFT, 0)):
        raise ScriptError("STRING did not encode a shifted key down")
    if bytes((EVT_DOWN, UNSHIFTED["i"], 0, 0)) not in payload:
        raise ScriptError("STRING did not encode a key down")
    repeated = translate("REPEAT 2\nSTRING a\nENDREPEAT\n")
    if repeated.count(bytes((EVT_DOWN, UNSHIFTED["a"], 0, 0))) != 2:
        raise ScriptError("REPEAT did not expand")
    chord = translate("CTRL-c\n", gap_ms=0)
    if chord != _key(UNSHIFTED["c"], MOD_LCTL):
        raise ScriptError("CTRL chord did not include the modifier on key up")
    if translate("CTRL c\n") != chord or translate("CONTROL c\n") != chord:
        raise ScriptError("CTRL c did not match the hyphen chord")
    gui = translate("GUI r\n")
    if gui != _key(UNSHIFTED["r"], MOD_LGUI) or translate("WINDOWS r\n") != gui:
        raise ScriptError("GUI r did not hold the Windows key")
    if translate("GUI\n") != _key(0, MOD_LGUI) or translate("WINDOWS GUI\n") != _key(0, MOD_LGUI):
        raise ScriptError("GUI alone did not tap the Windows key")
    if translate("STRINGLN a\n") != _char("a") + _key(NAMED["ENTER"]):
        raise ScriptError("STRINGLN did not type and press Enter")
    if top_line_limit(18) != 17 or top_line_limit(1) != 0:
        raise ScriptError("script scroll stopped before the last line")
    if translate("ALT F4\n") != _key(NAMED["F4"], MOD_LALT):
        raise ScriptError("ALT F4 did not encode")
    if translate("ESCAPE\n") != _key(NAMED["ESC"]) or translate("MENU\n") != _key(NAMED["APP"]):
        raise ScriptError("ESCAPE or MENU did not encode")
    for name in ("PRINTSCREEN", "PAGEUP", "PAGEDOWN", "HOME", "END"):
        if translate(name + "\n") != _key(NAMED[name]):
            raise ScriptError(f"{name} did not encode")
    paced = translate("DEFAULTDELAY 50\nSTRING ab\n")
    if paced != _char("a") + _char("b") + _delay(50):
        raise ScriptError("DEFAULTDELAY did not wait after STRING")
    if translate("REM note\n# note\nSTRING a\n") != translate("STRING a\n"):
        raise ScriptError("REM was not ignored")
    sample_script = "\n".join((
        "REM Open Run, then Command Prompt, then ping",
        "DEFAULTDELAY 200",
        "GUI r",
        "DELAY 500",
        "STRING cmd",
        "ENTER",
        "DELAY 700",
        "STRING ping google.com",
        "ENTER",
    ))
    if not translate(sample_script):
        raise ScriptError("example script produced no events")
    check_name("Cedar Labs")
    try:
        check_name("Logitech Board")
    except ScriptError:
        pass
    else:
        raise ScriptError("real vendor name was accepted")
    manufacturer, product = random_identity()
    check_name(manufacturer)
    check_name(product)
    if not translate(open_example("hello.txt")):
        raise ScriptError("hello example produced no events")
    if wrap_plain("one two three", 7) != ["one two", "three"]:
        raise ScriptError("text wrap broke")
    check_layout()
    if rule_group() != "users":
        raise ScriptError("udev rule group was not parsed")
    found = discover()
    if not any(path.name == "hello.txt" for path in found):
        raise ScriptError("hello example was not listed")
    import tempfile
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        (root / "top.txt").write_text("STRING a\n", encoding="utf-8")
        nested = root / "Pack"
        nested.mkdir()
        (nested / "inside.txt").write_text("STRING b\n", encoding="utf-8")
        closed = visible_tree([root], set(), include_root=False)
        labels = [tree_label(row, set()) for row in closed]
        if ">Pack" not in labels or any(row.path.name == "inside.txt" for row in closed):
            raise ScriptError(f"closed folder was not hidden: {labels}")
        opened = visible_tree([root], {nested}, include_root=False)
        shown = [tree_label(row, {nested}) for row in opened]
        if "↓Pack" not in shown or "│ inside.txt" not in shown:
            raise ScriptError(f"open folder did not show its file: {shown}")
        store = root / ".folders"
        save_saved_folders([nested], store)
        loaded = load_saved_folders(store)
        if loaded != [nested.resolve()]:
            raise ScriptError(f"saved folder was not kept: {loaded}")
        remembered = saved_folder_rows(loaded, {nested.resolve()})
        remembered_labels = [tree_label(row, {nested.resolve()}) for row in remembered]
        if "│ ↓Pack" not in remembered_labels or "│ │ inside.txt" not in remembered_labels:
            raise ScriptError(f"saved folder was not placed under scripts: {remembered_labels}")
    try:
        read_script("/no/such/kvxkeyinject.txt")
    except ScriptError:
        pass
    else:
        raise ScriptError("missing script was accepted")
    print("selftest ok")


def main(argv: list[str]) -> int:
    try:
        return dispatch(argv)
    except KeyboardInterrupt:
        print()
        return 130


def dispatch(argv: list[str]) -> int:
    if not argv:
        code = prepare_dependencies()
        if code:
            return code
        return launch_ui()
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.selftest:
            selftest()
            return 0
        if not args.cmd:
            parser.print_help()
            return 2
        code = prepare_dependencies()
        if code:
            return code
        run_command(args)
    except ScriptError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] == "--selftest":
        try:
            selftest()
        except ScriptError as exc:
            print(f"error: {exc}", file=sys.stderr)
            sys.exit(1)
        sys.exit(0)
    sys.exit(main(sys.argv[1:]))
