def run_cmd(cmd: list[str]) -> bool:
    print()
    print("  " + shlex.join(cmd))
    try:
        result = subprocess.run(cmd, env=command_env(cmd))
    except OSError as exc:
        print(f"  could not run that: {exc}")
        return False
    if result.returncode != 0:
        print(f"  exited {result.returncode}")
        return False
    print("  done")
    return True


def interpreter() -> str:
    if in_venv():
        return sys.executable
    if VENV_PYTHON.is_file():
        return str(VENV_PYTHON)
    return sys.executable


def switch_to_venv_if_ready() -> None:
    if in_venv() or os.environ.get("KVXKEYINJECT_REEXEC") == "1":
        return
    if not VENV_PYTHON.is_file() or not has_pyusb(str(VENV_PYTHON)):
        return
    script = str(Path(__file__).resolve())
    os.environ["KVXKEYINJECT_REEXEC"] = "1"
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), script, *sys.argv[1:]])


def relaunch(python: str) -> None:
    script = str(Path(__file__).resolve())
    argv = [python, script, *sys.argv[1:]]
    group = rule_group()
    use_sg = (
        os.environ.get("KVXKEYINJECT_SG") != "1"
        and shutil.which("sg")
        and not process_in_group(group)
        and user_in_group_db(group)
    )
    os.environ["KVXKEYINJECT_REEXEC"] = "1"
    try:
        if use_sg:
            print(f"Starting again with the {group} group.")
            os.environ["KVXKEYINJECT_SG"] = "1"
            os.execvp("sg", ["sg", group, "-c", shlex.join(argv)])
        print("Starting again.")
        os.execv(python, argv)
    except OSError as exc:
        print(f"could not restart: {exc}", file=sys.stderr)
        raise SystemExit(1)


def warn_if_group_is_stale() -> None:
    group = rule_group()
    if os.geteuid() == 0 or process_in_group(group) or not user_in_group_db(group):
        return
    if os.environ.get("KVXKEYINJECT_SG") != "1" and shutil.which("sg"):
        print(f"Starting with the {group} group.")
        script = str(Path(__file__).resolve())
        argv = [sys.executable, script, *sys.argv[1:]]
        os.environ["KVXKEYINJECT_SG"] = "1"
        try:
            os.execvp("sg", ["sg", group, "-c", shlex.join(argv)])
        except OSError as exc:
            print(f"could not start with the {group} group: {exc}")
    print(f"You are in the {group} group, but this login has not picked it up.")
    print("Log out and back in. Until then, opening the keyboard can fail.")


def prepare_dependencies() -> int:
    try:
        switch_to_venv_if_ready()
    except OSError as exc:
        print(f"could not switch to the virtualenv: {exc}", file=sys.stderr)
    gaps = collect_gaps()
    if not gaps:
        warn_if_group_is_stale()
        return 0
    print_gaps(gaps)
    runnable = [gap for gap in gaps if gap.commands]
    if not runnable:
        print("Install the items above, then run kvxkeyinject again.")
        return 1
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        print("Run kvxkeyinject in a terminal to install these, or run the commands above.")
        return 1
    needs_root = any(cmd and cmd[0] == "sudo" for gap in runnable for cmd in gap.commands)
    if needs_root:
        print("Installing uses sudo for system packages and may ask for your password.")
    if not ask("Install these now?", False):
        print("Nothing was installed. The commands above are the manual steps.")
        return 1
    for gap in runnable:
        for cmd in gap.commands:
            if not run_cmd(cmd):
                print()
                print("Stopped. What already succeeded is installed.")
                print("Run kvxkeyinject again to continue.")
                return 1
    print()
    print("Installed.")
    relaunch(interpreter())
    return 0


def panel_pixels() -> tuple[int, int] | None:
    try:
        text = Path("/sys/class/graphics/fb0/virtual_size").read_text().strip()
    except OSError:
        return None
    parts = text.split(",")
    if len(parts) != 2:
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None


def terminal_pixels() -> tuple[int, int] | None:
    try:
        packed = fcntl.ioctl(sys.stdin.fileno(), termios.TIOCGWINSZ, struct.pack("HHHH", 0, 0, 0, 0))
    except OSError:
        return None
    _rows, _cols, xpix, ypix = struct.unpack("HHHH", packed)
    if xpix and ypix:
        return int(xpix), int(ypix)
    return None


def fullscreen_hint() -> str | None:
    if panel_pixels() != (720, 720):
        return None
    pixels = terminal_pixels()
    if pixels is None:
        return None
    if pixels[0] < 640 or pixels[1] < 640:
        return "Fullscreen the terminal so the panel can use the 720×720 display."
    return None


