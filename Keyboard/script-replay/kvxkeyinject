def in_venv() -> bool:
    return sys.prefix != getattr(sys, "base_prefix", sys.prefix)


def user_name() -> str:
    return pwd.getpwuid(os.getuid()).pw_name


def as_root(cmd: list[str]) -> list[str]:
    if os.geteuid() == 0:
        return cmd
    if not shutil.which("sudo"):
        return cmd
    if cmd and cmd[0] == "apt-get":
        return ["sudo", "DEBIAN_FRONTEND=noninteractive", *cmd]
    return ["sudo", *cmd]


def command_env(cmd: list[str]) -> dict[str, str]:
    env = os.environ.copy()
    if "apt-get" in cmd:
        env["DEBIAN_FRONTEND"] = "noninteractive"
    return env


def has_pyusb(python: str | None = None) -> bool:
    if python is None:
        try:
            import usb.core  # noqa: F401
        except ImportError:
            return False
        return True
    try:
        result = subprocess.run(
            [python, "-c", "import usb.core"],
            capture_output=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def ensurepip_ok() -> bool:
    try:
        import ensurepip  # noqa: F401
    except ImportError:
        return False
    return True


def libusb_ok() -> bool:
    if ctypes.util.find_library("usb-1.0"):
        return True
    try:
        import usb.backend.libusb1 as backend
    except ImportError:
        return False
    return backend.get_backend() is not None


def libusb_install() -> list[str] | None:
    if shutil.which("apt-get"):
        return as_root(["apt-get", "install", "-y", "libusb-1.0-0"])
    if shutil.which("dnf"):
        return as_root(["dnf", "install", "-y", "libusb1"])
    if shutil.which("pacman"):
        return as_root(["pacman", "-S", "--noconfirm", "libusb"])
    if shutil.which("zypper"):
        return as_root(["zypper", "--non-interactive", "install", "libusb-1_0-0"])
    return None


def rule_group() -> str:
    try:
        text = RULE.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "users"
    for token in text.replace(",", " ").split():
        if "GROUP=" not in token:
            continue
        value = token.split("GROUP=", 1)[1].strip().strip('"').strip("'")
        if value:
            return value
    return "users"


def rule_matches() -> bool:
    try:
        current = INSTALLED_RULE.read_text(encoding="utf-8", errors="replace").strip()
        wanted = RULE.read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return False
    return bool(current) and current == wanted


def group_record(name: str):
    try:
        return grp.getgrnam(name)
    except KeyError:
        return None


def process_in_group(name: str) -> bool:
    if os.geteuid() == 0:
        return True
    group = group_record(name)
    if group is None:
        return False
    return group.gr_gid == os.getgid() or group.gr_gid in os.getgroups()


def user_in_group_db(name: str) -> bool:
    group = group_record(name)
    if group is None:
        return False
    user = user_name()
    if user in group.gr_mem:
        return True
    try:
        return pwd.getpwnam(user).pw_gid == group.gr_gid
    except KeyError:
        return False


def pip_command(python: str) -> list[str]:
    if REQUIREMENTS.is_file():
        return [python, "-m", "pip", "install", "-r", str(REQUIREMENTS)]
    return [python, "-m", "pip", "install", "pyusb"]


def collect_gaps() -> list[Gap]:
    gaps = []
    if not has_pyusb():
        commands: list[list[str]] = []
        if in_venv():
            detail = "pyusb is the USB library. It is not installed in this virtualenv."
            commands.append(pip_command(sys.executable))
        else:
            detail = "pyusb is the USB library. It is installed into .venv next to this file."
            if not VENV_PYTHON.is_file():
                if not ensurepip_ok() and shutil.which("apt-get"):
                    commands.append(as_root(["apt-get", "install", "-y", "python3-venv"]))
                commands.append([sys.executable, "-m", "venv", str(HERE / ".venv")])
            commands.append(pip_command(str(VENV_PYTHON)))
        gaps.append(Gap("pyusb", detail, commands))
    if not libusb_ok():
        command = libusb_install()
        if command is None:
            gaps.append(Gap(
                "libusb",
                "pyusb opens USB devices through libusb 1.0. Install that shared library with your package manager.",
                [],
            ))
        else:
            gaps.append(Gap(
                "libusb",
                "pyusb opens USB devices through libusb 1.0.",
                [command],
            ))
    if not rule_matches():
        if not RULE.is_file():
            gaps.append(Gap(
                "udev rule",
                "99-hackberry-script.rules is missing next to kvxkeyinject, so it cannot be copied.",
                [],
            ))
        else:
            gaps.append(Gap(
                "udev rule",
                "Lets your user claim raw HID interface 1. The boot keyboard stays with the kernel.",
                [
                    as_root(["cp", str(RULE), str(INSTALLED_RULE)]),
                    as_root(["udevadm", "control", "--reload"]),
                    as_root(["udevadm", "trigger"]),
                ],
            ))
    group = rule_group()
    if os.geteuid() != 0 and not process_in_group(group) and not user_in_group_db(group):
        commands = []
        if group_record(group) is None:
            commands.append(as_root(["groupadd", group]))
        commands.append(as_root(["usermod", "-aG", group, user_name()]))
        gaps.append(Gap(
            f"{group} group",
            f"The udev rule grants the {group} group. This account is not a member yet.",
            commands,
        ))
    return gaps


def ask(prompt: str, default_yes: bool = False) -> bool:
    suffix = " [Y/n] " if default_yes else " [y/N] "
    try:
        answer = input(prompt + suffix).strip().lower()
    except EOFError:
        print()
        return False
    if not answer:
        return default_yes
    return answer in ("y", "yes")


def print_gaps(gaps: list[Gap]) -> None:
