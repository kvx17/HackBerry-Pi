def run_command(args, emit=say) -> None:
    if args.cmd == "list":
        try:
            import usb.core
        except ImportError as exc:
            raise ScriptError("pyusb is not installed in this Python") from exc
        found = list(usb.core.find(find_all=True, idVendor=VID, idProduct=PID))
        if not found:
            raise ScriptError("device missing: no USB device at 4242:0003")
        for device in found:
            emit(f"4242:0003 bus {device.bus} address {device.address}")
        return

    board = open_board()
    try:
        if args.cmd == "ping":
            emit(status_text(board.status(CMD_PING)))
        elif args.cmd == "status":
            emit(status_text(board.status()))
        elif args.cmd == "info":
            product = ""
            manufacturer = ""
            try:
                manufacturer = board.device.manufacturer or ""
                product = board.device.product or ""
            except Exception:
                pass
            emit(f"usb manufacturer {manufacturer}")
            emit(f"usb product {product}")
            emit("Stored names apply on the next enumeration.")
            emit(status_text(board.status()))
            emit(f"stored manufacturer {cmd_identity_get(board, 1)}")
            emit(f"stored product {cmd_identity_get(board, 2)}")
        elif args.cmd == "send":
            payload = translate(read_script(args.file))
            if not payload:
                raise ScriptError("script produced no events")
            cmd_send(board, payload, emit)
        elif args.cmd == "verify":
            payload = translate(read_script(args.file))
            info = board.status()
            if not info["valid"]:
                raise ScriptError("verify: slot is empty")
            if info["length"] != len(payload) or info["crc"] != crc32(payload):
                raise ScriptError("verify: length or CRC does not match")
            if read_back(board, len(payload)) != payload:
                raise ScriptError("verify: read-back does not match")
            emit(f"verified {len(payload)} bytes")
        elif args.cmd == "clear":
            reply = board.xfer(bytes((CMD_CLEAR,)))
            if reply[1] not in (OK, ERR_BUSY):
                raise ScriptError(f"clear: {ERR_NAME.get(reply[1], reply[1])}")
            done = board.wait_idle()
            if done["valid"]:
                raise ScriptError("clear finished but the slot is still valid")
            emit("cleared")
        elif args.cmd == "identity":
            do_identity(board, args, emit)
        else:
            raise ScriptError("unknown command")
    finally:
        board.close()


